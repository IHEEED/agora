# Скопируйте в .env и подставьте свои значения.
PORT=4000
SUPABASE_URL=https://ваш-проект.supabase.co
# service_role ключ: он обходит Row Level Security, держите его только на сервере.
SUPABASE_SERVICE_KEY=ваш-service-role-ключ

# Кому не писан заслон «подтверди телефон, чтобы писать».
# Почты или идентификаторы через запятую. Пусто = заслон для всех.
PHONE_GATE_EXEMPT=
