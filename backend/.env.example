# Скопируйте в .env и подставьте свои значения.
PORT=4000
SUPABASE_URL=https://ваш-проект.supabase.co
# service_role ключ: он обходит Row Level Security, держите его только на сервере.
SUPABASE_SERVICE_KEY=ваш-service-role-ключ

# Кому не писан заслон «подтверди телефон, чтобы писать».
# Почты или идентификаторы через запятую. Пусто = заслон для всех.
PHONE_GATE_EXEMPT=

# Мониторинг ошибок (Sentry). Пусто = выключено (тихий no-op).
# DSN проекта из Sentry → Settings → Projects → Client Keys (DSN).
SENTRY_DSN=
# Доля запросов под трассировку производительности (0..1). 0 = только ошибки.
SENTRY_TRACES_SAMPLE_RATE=0

# Подтверждение телефона через Telegram-бота (@BotFather). Пусто = выключено,
# гейт работает по-старому. Токен — секрет, в git не коммитим.
TELEGRAM_BOT_TOKEN=
# @username бота без «@» (по умолчанию ParafrazLegitBot).
TELEGRAM_BOT_USERNAME=ParafrazLegitBot

# Аккаунт поддержки (id пользователя): забаненному разрешено писать только ему,
# чтобы подать апелляцию. По умолчанию — @parafraz.
SUPPORT_USER_ID=
# Публичный адрес бэкенда для вебхука. На Railway можно не задавать — возьмётся
# из RAILWAY_PUBLIC_DOMAIN автоматически. Локально: https://<туннель>.
PUBLIC_BASE_URL=
